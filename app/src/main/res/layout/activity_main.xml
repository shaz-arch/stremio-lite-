<?xml version="1.0" encoding="utf-8"?>
<!-- Padding keeps everything inside the TV's safe area (overscan) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dos_blue"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp"
    android:paddingBottom="27dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/dos_yellow"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clock_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/dos_grey"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/dos_grey"
            android:textSize="20sp" />
    </LinearLayout>

    <View
        android:id="@+id/rule_top"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/dos_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:drawSelectorOnTop="false"
            android:focusable="true"
            android:listSelector="@drawable/row_highlight"
            android:scrollbars="vertical" />

        <!-- Only the sign-in screen uses this, for the QR code -->
        <ImageView
            android:id="@+id/side_image"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="24dp"
            android:background="@color/dos_white"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/rule_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/dos_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/footer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="@string/keys_hint"
            android:textColor="@color/dos_grey"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/dos_grey"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
